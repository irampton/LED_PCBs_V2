@require("TPS5430DDAR");

module Buck () {
    rail input;
    rail output;
    output.voltage = 3.3V;

    part regulator = new TPS5430DDAR();
    part cin1 = new Capacitor(value = "10uF", footprint = "1206", LCSC = "C13585", voltage = 50V);
    part cin2 = new Capacitor(value = "10uF", footprint = "1206", LCSC = "C13585", voltage = 50V);
    part bootstrap = new Capacitor(value = "10nF", footprint = "0402", LCSC = "C15195", voltage = 50V);
    part inductor = new Inductor(value = "15uH", footprint = "IND-SMD_L7.0-W6.6-H3.0", LCSC = "C54431704");
    part flyback = new Diode(value = "SS34", footprint = "SMA", LCSC = "C8678");
    part cout1 = new Capacitor(value = "100uF", footprint = "1206", LCSC = "C15008", voltage = 6.3V);
    part cout2 = new Capacitor(value = "100uF", footprint = "1206", LCSC = "C15008", voltage = 6.3V);

    // 1.221 V * (1 + 5.1k / 3k) = 3.297 V.
  part fb_upper = new Resistor(value = "5.1k", footprint = "0603", LCSC="C23186");
    part fb_lower = new Resistor(value = "3k", footprint = "0603", LCSC="C4211");

    // Figure 7-11 C6 realized as 3 nF in parallel using Basic parts.
    part ff_main = new Capacitor(value = "1nF", footprint = "0402", LCSC = "C1523", voltage = 50V);
    part ff_trim1 = new Capacitor(value = "1nF", footprint = "0402", LCSC = "C1523", voltage = 50V);
    part ff_trim2 = new Capacitor(value = "1nF", footprint = "0402", LCSC = "C1523", voltage = 50V);
    part comp_shunt = new Capacitor(value = "220pF", footprint = "0402", LCSC = "C1530", voltage = 50V);
    part comp_cap = new Capacitor(value = "220nF", footprint = "0603", LCSC = "C21120", voltage = 25V);
    part comp_res = new Resistor(value = "270", footprint = "0603", LCSC = "C22966");

    input.h ~ regulator.VIN;
    input.h ~> cin1 ~> input.l;
    input.h ~> cin2 ~> input.l;

    net switching;
    switching ~ regulator.PH;
    switching ~ flyback.0;
    switching ~> inductor ~> output.h;
    regulator.BOOT ~> bootstrap ~> switching;

    net feedback;
    output.h ~> fb_upper ~> feedback;
    feedback ~ regulator.VSENSE;
    feedback ~> fb_lower ~> output.l;
    output.h ~> ff_main ~> feedback;
    output.h ~> ff_trim1 ~> feedback;
    output.h ~> ff_trim2 ~> feedback;
    feedback ~> comp_shunt ~> output.l;
    feedback ~> comp_cap ~> comp_res ~> output.l;

    output.h ~> cout1 ~> output.l;
    output.h ~> cout2 ~> output.l;

    input.l ~ output.l;
    input.l ~ regulator.GND;
    input.l ~ regulator.DAP;
    input.l ~ flyback.1;
}

module top () {
    mod buck = new Buck();
    rail input;
    rail output;
    input.h.name = "VIN";
    input.l.name = "GND";
    output.h.name = "3V3";
    input.h ~ buck.input.h;
    input.l ~ buck.input.l;
    output.h ~ buck.output.h;
    output.l ~ buck.output.l;
}
