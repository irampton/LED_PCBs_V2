@require("Texas_Instruments_TPS54331DR");

// Original TPS54331 buck, preserving every original part and pin connection.
// Drop-in source alternative: import Buck5V from "./old_buck.schrune".
// Interface matches buck.schrune: input.h/input.l and output.h/output.l.
// Original enable divider, feedback, compensation and soft-start are unchanged.
module Buck5V () {
    rail input;
    rail output;
    output.voltage = 5V;
    input.l ~ output.l;

    part buck_boot_cap = new Capacitor(value = "100nF", footprint = "0402", LCSC = "C1525", voltage = 16V);
    part buck_cin1_0 = new Capacitor(value = "4.7uF", footprint = "1206", LCSC = "C29823", voltage = 50V);
    part buck_cin1_1 = new Capacitor(value = "4.7uF", footprint = "1206", LCSC = "C29823", voltage = 50V);
    part buck_cin2 = new Capacitor(value = "10nF", footprint = "0402", LCSC = "C15195", voltage = 50V);
    part buck_comp_c1 = new Capacitor(value = "47pF", footprint = "0402", LCSC = "C1567", voltage = 50V);
    part buck_comp_c2 = new Capacitor(value = "1nF", footprint = "0402", LCSC = "C1523", voltage = 50V);
    part buck_comp_r1 = new Resistor(value = "30k", footprint = "0603", LCSC = "C22984");
    part buck_cout_0 = new Capacitor(value = "47uF", footprint = "1206", LCSC = "C96123", voltage = 10V);
    part buck_cout_1 = new Capacitor(value = "47uF", footprint = "1206", LCSC = "C96123", voltage = 10V);
    part buck_en_r1 = new Resistor(value = "330k", footprint = "0402", LCSC = "C25778");
    part buck_en_r2 = new Resistor(value = "68k", footprint = "0402", LCSC = "C36871");
    part buck_fb_r1 = new Resistor(value = "10k", footprint = "0402", LCSC = "C25744");
    part buck_fb_r2 = new Resistor(value = "1.8k", footprint = "0603", LCSC = "C4177");
    part buck_flyback = new Diode(value = "SS34", footprint = "SMA", LCSC = "C8678");
    part buck_inductor = new Inductor(value = "6.8uH", footprint = "IND-SMD_L7.0-W6.6-H3.0", LCSC = "C22463822");
    part buck_regulator = new Texas_Instruments_TPS54331DR();
    part buck_ss_cap = new Capacitor(value = "10nF", footprint = "0402", LCSC = "C15195", voltage = 50V);

    output.h ~ buck_cout_0.0;
    output.h ~ buck_cout_1.0;
    output.h ~ buck_fb_r1.0;
    output.h ~ buck_inductor.1;

    net EN;
    EN ~ buck_en_r1.1;
    EN ~ buck_en_r2.0;
    EN ~ buck_regulator.pin_EN;

    input.l ~ buck_cin1_0.1;
    input.l ~ buck_cin1_1.1;
    input.l ~ buck_cin2.1;
    input.l ~ buck_comp_c1.1;
    input.l ~ buck_comp_r1.1;
    input.l ~ buck_cout_0.1;
    input.l ~ buck_cout_1.1;
    input.l ~ buck_en_r2.1;
    input.l ~ buck_fb_r2.1;
    input.l ~ buck_flyback.1;
    input.l ~ buck_regulator.pin_GND;
    input.l ~ buck_ss_cap.1;

    input.h ~ buck_cin1_0.0;
    input.h ~ buck_cin1_1.0;
    input.h ~ buck_cin2.0;
    input.h ~ buck_en_r1.0;
    input.h ~ buck_regulator.pin_VIN;

    net VSENSE;
    VSENSE ~ buck_fb_r1.1;
    VSENSE ~ buck_fb_r2.0;
    VSENSE ~ buck_regulator.pin_VSENSE;

    net buck_bootstrap;
    buck_bootstrap ~ buck_boot_cap.1;
    buck_bootstrap ~ buck_flyback.0;
    buck_bootstrap ~ buck_inductor.0;
    buck_bootstrap ~ buck_regulator.pin_PH;

    net net_comp_c2_power_hv;
    net_comp_c2_power_hv ~ buck_comp_c1.0;
    net_comp_c2_power_hv ~ buck_comp_c2.0;
    net_comp_c2_power_hv ~ buck_regulator.pin_COMP;

    net buck_switch;
    buck_switch ~ buck_boot_cap.0;
    buck_switch ~ buck_regulator.pin_BOOT;

    net buck_ground;
    buck_ground ~ buck_comp_c2.1;
    buck_ground ~ buck_comp_r1.0;

    net net_ss_cap_power_hv;
    net_ss_cap_power_hv ~ buck_regulator.pin_SS;
    net_ss_cap_power_hv ~ buck_ss_cap.0;
}

module top () {
    mod buck = new Buck5V();
    rail input;
    rail output;
    input ~ buck;
    output ~ buck.output;
}
